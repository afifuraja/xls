# Walk through all subdirectories
for foldername, subfolders, filenames in os.walk(root_folder):
    for filename in filenames:
        if filename.lower().endswith('.gen'):
            original_file_path = os.path.join(foldername, filename)
            folder_base_name = os.path.basename(foldername)
            new_filename = folder_base_name + '.gen'
            new_file_path = os.path.join(foldername, new_filename)

            # Generate a unique filename if needed
            safe_file_path = get_unique_filename(new_file_path)

            # Rename the file
            os.rename(original_file_path, safe_file_path)
            print(f'Extracted: {zip_path} to {foldername}')
            print(f"Renamed: {filename} → {os.path.basename(safe_file_path)}")
